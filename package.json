{
  "name": "kingdomsaudi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "cms:dev": "powershell.exe -NoProfile -File scripts/cms-local.ps1 dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "cms:seed": "node --import tsx scripts/seed.ts",
    "cms:generate-types": "payload generate:types",
    "cms:migrate:create": "payload migrate:create",
    "cms:migrate": "payload migrate"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.88.0",
    "@payloadcms/next": "^3.88.0",
    "@payloadcms/storage-s3": "^3.88.0",
    "@payloadcms/translations": "^3.88.0",
    "graphql": "^16.14.2",
    "next": "16.3.4",
    "payload": "^3.88.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sass": "^1.104.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
